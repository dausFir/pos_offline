# Environment Configuration for Kasir UMKM

# JWT Secret Key for token signing (WAJIB diganti di production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-32-characters
AUDIT_HMAC_KEY=change-this-to-a-separate-audit-secret-at-least-32-characters
# Optional: encrypted automatic daily backup at 02:00 (never commit a real value)
AUTO_BACKUP_PASSWORD=
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14
# Optional public tracking sync (the Vercel app endpoint). Both values must be
# present; the secret is kept in the process environment, never in SQLite.
TRACKING_SYNC_URL=https://your-tracker.vercel.app/api/sync
TRACKING_SYNC_SECRET=replace-with-the-same-long-secret-configured-on-vercel
# Only needed for a separate frontend development server, e.g. http://localhost:5173
CORS_ALLOWED_ORIGIN=
INITIAL_ADMIN_PASSWORD=change-this-to-a-strong-password

# Database Configuration
DATABASE_PATH=database.sqlite

# Server Configuration  
SERVER_PORT=8080
SERVER_HOST=localhost

# Security Settings
SESSION_TIMEOUT_HOURS=24
REFRESH_TOKEN_DAYS=30

# Development Settings
DEBUG_MODE=false
LOG_LEVEL=info
# Copy this file to .env and update the values

# JWT Secret (REQUIRED in production)
# Generate with: openssl rand -base64 48
# Must be at least 32 characters
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production-minimum-32-chars

# Database Configuration
DB_PATH=database.sqlite

# Server Configuration  
PORT=8080
SERVER_HOST=0.0.0.0

# Debug Mode (set to false in production)
DEBUG=true

# Store Information
STORE_NAME="Toko Saya"
STORE_ADDRESS="Jl. Contoh No. 123"

# Security Settings
ACCESS_TOKEN_DURATION_MINUTES=30
REFRESH_TOKEN_DURATION_DAYS=30
