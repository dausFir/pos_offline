# RapiPos runtime configuration
# Copy this file to .env, then replace every placeholder with a real value.
# Do not commit .env.

# Use "production" for a release installation. Development allows a missing
# audit key, but production requires both JWT_SECRET and AUDIT_HMAC_KEY.
GO_ENV=development
JWT_SECRET=replace-with-a-random-jwt-secret-at-least-32-characters
AUDIT_HMAC_KEY=replace-with-a-separate-random-audit-secret-at-least-32-characters

# Required only when creating a brand-new database. The initial account is
# username "admin" with super_admin role.
INITIAL_ADMIN_PASSWORD=replace-with-an-initial-admin-password-at-least-12-characters

# Local network access. RapiPos starts at SERVER_PORT and selects another free
# port automatically when the requested port is already occupied.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Optional encrypted automatic daily backup at 02:00. Leave password empty to
# disable it. Never store a real backup password in source control.
AUTO_BACKUP_PASSWORD=
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14

# Optional public service-tracking sync. Both values are required to enable
# sync. The secret stays in the POS process environment and is never stored in
# SQLite or exposed through the owner settings page.
TRACKING_SYNC_URL=
TRACKING_SYNC_SECRET=

# Needed only if a separate Vite development server calls the API.
CORS_ALLOWED_ORIGIN=
